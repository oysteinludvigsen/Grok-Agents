{
  "manifest_version": 3,
  "name": "Grok Agent",
  "version": "1.0.0",
  "description": "Enable agentic capabilities for Grok — execute shell commands locally via your Supergrok subscription",
  "minimum_chrome_version": "116",

  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://grok.com/*",
    "https://x.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*",
        "https://x.com/i/grok*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Grok Agent"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["GROK_TEMPLATE_PROMPT.md"],
      "matches": ["<all_urls>"]
    }
  ]
}
